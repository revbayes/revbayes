# condition="nTaxa". The count at the present is geometric with an atom at zero,
#
#   alpha = mu (1 - e^-(lambda-mu)x) / (lambda - mu e^-(lambda-mu)x)
#   beta  = lambda (1 - e^-(lambda-mu)x) / (lambda - mu e^-(lambda-mu)x)
#
# so P(0) = alpha, P(n) = (1 - alpha)(1 - beta) beta^(n-1), and the conditioning pays -log P(n).
# Six taxa, three of them extant. Each check takes the origin from the process rather than
# hardcoding it, so the identities hold at any origin. Every line printed must be TRUE.
taxa <- readTaxonData("data/fbdr_condition.tsv")

lambda ~ dnExponential(1); lambda.setValue(0.4)
mu     ~ dnExponential(1); mu.setValue(0.1)
psi    ~ dnExponential(1); psi.setValue(0.5)
origin ~ dnUniform(8, 30);  origin.setValue(20)

bd_t ~ dnFBDRP(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=1.0, present=0.0,
               condition="time", origin=origin, survivors=true)
rec_t ~ dnFossilRecord(ranges=bd_t, complete=true)
rec_t.clamp(taxa)

# one configuration throughout, so the nodes differ only by their conditioning
config <- bd_t
ori <- bd_t.getOrigin()

bd_c ~ dnFBDRP(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=1.0, present=0.0,
               condition="nTaxa", origin=origin, survivors=true)
bd_c.setValue(config)
rec_c ~ dnFossilRecord(ranges=bd_c, complete=true)
rec_c.clamp(taxa)

d <- lambda - mu
ex <- exp(-d * ori)
alpha <- mu * (1 - ex) / (lambda - mu * ex)
beta <- lambda * (1 - ex) / (lambda - mu * ex)
expected <- -( ln(1 - alpha) + ln(1 - beta) + 2 * ln(beta) )
observed <- bd_c.lnProbability() - bd_t.lnProbability()

out = "output/condition_nTaxa.txt"
print(filename=out, "the factor matches its closed form at the record's own count of 3:\n")
print(filename=out, append=TRUE, abs(observed - expected) < 1E-8, "\n")

# intervals that share a rate must not move the factor: the composition check
timeline <- v(1.0, 2.0, 3.0, 4.0)
lv := v(lambda, lambda, lambda, lambda, lambda)
mv := v(mu, mu, mu, mu, mu)
pv := v(psi, psi, psi, psi, psi)

bd_s ~ dnFBDRP(taxa=taxa, lambda=lv, mu=mv, psi=pv, rho=1.0, present=0.0, timeline=timeline,
               condition="nTaxa", origin=origin, survivors=true)
bd_s.setValue(config)
rec_s ~ dnFossilRecord(ranges=bd_s, complete=true)
rec_s.clamp(taxa)

print(filename=out, append=TRUE, "five intervals of one rate match one interval:\n")
print(filename=out, append=TRUE, abs(bd_s.lnProbability() - bd_c.lnProbability()) < 1E-8, "\n")

# rho thins the survivors, so the factor cannot rise
bd_r ~ dnFBDRP(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=0.5, present=0.0,
               condition="nTaxa", origin=origin, survivors=true)
bd_r.setValue(config)
rec_r ~ dnFossilRecord(ranges=bd_r, complete=true)
rec_r.clamp(taxa)

bd_rt ~ dnFBDRP(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=0.5, present=0.0,
                condition="time", origin=origin, survivors=true)
bd_rt.setValue(config)
rec_rt ~ dnFossilRecord(ranges=bd_rt, complete=true)
rec_rt.clamp(taxa)

print(filename=out, append=TRUE, "rho below one does not raise the factor:\n")
print(filename=out, append=TRUE, (bd_r.lnProbability() - bd_rt.lnProbability()) <= observed, "\n")

# dnBDS pays the same factor
bds_t ~ dnBDS(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=1.0, present=0.0,
              condition="time", origin=origin)
rs_t ~ dnFossilRecord(ranges=bds_t, complete=true)
rs_t.clamp(taxa)
bds_cfg <- bds_t
bds_ori <- bds_t.getOrigin()

bds_c ~ dnBDS(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=1.0, present=0.0,
              condition="nTaxa", origin=origin)
bds_c.setValue(bds_cfg)
rs_c ~ dnFossilRecord(ranges=bds_c, complete=true)
rs_c.clamp(taxa)

ex2 <- exp(-d * bds_ori)
a2 <- mu * (1 - ex2) / (lambda - mu * ex2)
b2 <- lambda * (1 - ex2) / (lambda - mu * ex2)
print(filename=out, append=TRUE, "dnBDS pays the same factor:\n")
print(filename=out, append=TRUE,
      abs((bds_c.lnProbability() - bds_t.lnProbability())
          - -( ln(1 - a2) + ln(1 - b2) + 2 * ln(b2) )) < 1E-8, "\n")

q()
