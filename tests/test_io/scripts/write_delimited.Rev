data = readDiscreteCharacterData("data/bears_cytb.nex")

writeDelimitedCharacterData( "output/bears_cytb.ssv", data)
writeDelimitedCharacterData( "output/bears_cytb.csv", data, "," )
writeDelimitedCharacterData( "output/bears_cytb.tsv", data, "\t" )
