## continue-on-error
# A letter O in place of a zero: the old stringstream extraction stopped at the O and
# silently returned 3.0. A field that does not parse at all returned 0.
readTaxonData("data/taxa_bad_number.tsv")
readTaxonData("data/taxa_unparseable_number.tsv")

# Inf is a valid upper bound for an occurrence age
taxa = readTaxonData("data/taxa_inf_age.tsv")
taxa[1].getMaxAge()

# Whole-range updates accept ordered bounds and reject reversed bounds.
taxa[1].setAgeRange(2, 3)
taxa[1].setAgeRange(3, 2)

# Presence must distinguish an unset range from explicit zero and survive whole-range assignment.
# Scalar getter tests cannot distinguish these states; retain this while ranges are optional.
unset = taxon("unset")
unset.hasAgeRange()
taxon("zero", age=0).hasAgeRange()
unset.setAgeRange(0, 0)
unset.hasAgeRange()
