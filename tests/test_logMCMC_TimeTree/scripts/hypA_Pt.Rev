################################################################################
#
# Hypothesis A: ordered-eigen P(t) is platform-dependent at short t; JC and
# ordered scalingAndSquaring are not.
#
# Prints getTransitionProbabilities at several t. Compare Mac vs Linux output.
# Placeholder expected errout so Linux CI uploads output/.
#
################################################################################

setOption("outputPrecision", "17", false)

ts = [1E-8, 1E-6, 1E-4, 0.01, 1.0]
ns = [3, 4]

for (ni in 1:ns.size())
{
    n = ns[ni]

    Qjc = fnJC(n)
    Qeig = fnOrderedRateMatrix(n, lambda=1, mu=1, matrixExponentialMethod="eigen")
    Qss  = fnOrderedRateMatrix(n, lambda=1, mu=1, matrixExponentialMethod="scalingAndSquaring")

    methods = ["JC", "ordered_eigen", "ordered_scalingAndSquaring"]
    Qs = [Qjc, Qeig, Qss]

    for (mi in 1:methods.size())
    {
        for (ti in 1:ts.size())
        {
            t = ts[ti]
            P = Qs[mi].getTransitionProbabilities(rate=t)
            for (i in 1:n)
            {
                for (j in 1:n)
                {
                    print("PT method=" + methods[mi] + " n=" + n + " t=" + t + " i=" + i + " j=" + j)
                    print(P[i][j])
                }
            }
        }
    }
}

print("HYPA_PT_FINISHED")
q()
