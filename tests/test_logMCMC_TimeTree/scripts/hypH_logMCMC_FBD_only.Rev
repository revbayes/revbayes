################################################################################
#
# Hypothesis H: the Mac/Linux fork does not need a phyloCTMC. Same seed, FBD
# tree, and tree moves as hypF/G, but no morphology, no UCLN, no site rates.
# If accept/reject still diverges, the split is in FBD/age arithmetic.
# If it does not, CTMC pruning is required.
#
################################################################################

seed(12345)

# Session-only: do not write ~/.RevBayes.ini
setOption("debugMCMC", "1", false)
setOption("logMCMC", "2", false)

taxa <- readTaxonData("data/ceratosauria_tip_ages.tsv")

moves = VectorMoves()
monitors = VectorMonitors()

diversification ~ dnExponential(10.0)
moves.append( mvScale(diversification, weight=9, tune=true) )

rel_extinction ~ dnBeta(2.0, 1.0)
moves.append( mvSlide(rel_extinction, weight=9, tune=true) )

fossil_prob ~ dnUniform(0.0, 1.0)
moves.append( mvSlide(fossil_prob, weight=9, tune=true) )

speciation := diversification / abs(1.0 - rel_extinction)
extinction := (rel_extinction * diversification) / abs(1.0 - rel_extinction)
recovery := (fossil_prob / abs(1.0 - fossil_prob)) * extinction

rho <- 1

origin_time ~ dnExponential(lambda=1/(212.6 - 197.5), offset=197.5)
moves.append( mvSlide(origin_time, weight=9, tune=true) )

tree_dist = dnFBDP(rootAge=origin_time, lambda=speciation, mu=extinction, psi=recovery,
                   rho=rho, taxa=taxa)

backbone_tree = readTrees("data/abelisauroidea_backbone_incomplete_binary.tre", treetype="clock")[1]
init_tree = readTrees("data/abelisauroidea_initial.tre", treetype="clock")[1]
scaled_init_tree <- fnMinBLTimeScaling(init_tree, taxa, 5)

fbd_tree ~ dnConstrainedTopology(tree_dist, backbone=backbone_tree,
                                 initialTree=scaled_init_tree)

moves.append( mvFNPR(fbd_tree, weight=15.0) )
moves.append( mvCollapseExpandFossilBranch(fbd_tree, origin_time, weight=6.0) )
moves.append( mvNodeTimeSlideUniform(fbd_tree, weight=40.0) )

fossils = fbd_tree.getFossils()
for(i in 1:fossils.size())
{
    t[i] := tmrca(fbd_tree, clade(fossils[i]))

    a[i] <- fossils[i].getMinAge()
    b[i] <- fossils[i].getMaxAge()

    F[i] ~ dnUniform(t[i] - b[i], t[i] - a[i])
    F[i].clamp( 0 )

    moves.append( mvFossilTimeSlideUniform(fbd_tree, origin_time, fossils[i], weight = 1.0) )
}

print("INIT_FINGERPRINT origin_time=")
print(origin_time)
print("INIT_FINGERPRINT diversification=")
print(diversification)

mymodel = model(fbd_tree)
mymcmc = mcmc(mymodel, monitors, moves)
mymcmc.burnin(generations=100, tuningInterval=5)

print("LOGMCMC_DUMP_FINISHED")
q()
