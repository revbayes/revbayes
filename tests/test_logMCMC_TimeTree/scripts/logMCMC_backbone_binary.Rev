################################################################################
#
# Short logMCMC/debugMCMC dump of the backbone+initialTree FBD clock test.
# Purpose: compare the first two burn-in generations Mac vs Linux (same seed).
# Do not keep this as a golden-file test; the expected errout is a placeholder
# so Linux CI fails and uploads output/.
#
################################################################################

seed(12345)

# Session-only: do not write ~/.RevBayes.ini
setOption("debugMCMC", "1", false)
setOption("logMCMC", "2", false)

taxa <- readTaxonData("data/ceratosauria_tip_ages.tsv")
morpho <- readDiscreteCharacterData("data/ceratosauria_morphology.nex")

n_taxa <- morpho.ntaxa()
n_branches <- 2 * n_taxa - 2

moves = VectorMoves()
monitors = VectorMonitors()

diversification ~ dnExponential(10.0)
moves.append( mvScale(diversification, weight=9, tune=true) )

rel_extinction ~ dnBeta(2.0, 1.0)
moves.append( mvSlide(rel_extinction, weight=9, tune=true) )

fossil_prob ~ dnUniform(0.0, 1.0)
moves.append( mvSlide(fossil_prob, weight=9, tune=true) )

speciation := diversification / abs(1.0 - rel_extinction)
extinction := (rel_extinction * diversification) / abs(1.0 - rel_extinction)
recovery := (fossil_prob / abs(1.0 - fossil_prob)) * extinction

rho <- 1

origin_time ~ dnExponential(lambda=1/(212.6 - 197.5), offset=197.5)
moves.append( mvSlide(origin_time, weight=9, tune=true) )

tree_dist = dnFBDP(rootAge=origin_time, lambda=speciation, mu=extinction, psi=recovery,
                   rho=rho, taxa=taxa)

backbone_tree = readTrees("data/abelisauroidea_backbone_incomplete_binary.tre", treetype="clock")[1]
init_tree = readTrees("data/abelisauroidea_initial.tre", treetype="clock")[1]
scaled_init_tree <- fnMinBLTimeScaling(init_tree, taxa, 5)

fbd_tree ~ dnConstrainedTopology(tree_dist, backbone=backbone_tree,
                                 initialTree=scaled_init_tree)

moves.append( mvFNPR(fbd_tree, weight=15.0) )
moves.append( mvCollapseExpandFossilBranch(fbd_tree, origin_time, weight=6.0) )
moves.append( mvNodeTimeSlideUniform(fbd_tree, weight=40.0) )

fossils = fbd_tree.getFossils()
for(i in 1:fossils.size())
{
    t[i] := tmrca(fbd_tree, clade(fossils[i]))

    a[i] <- fossils[i].getMinAge()
    b[i] <- fossils[i].getMaxAge()

    F[i] ~ dnUniform(t[i] - b[i], t[i] - a[i])
    F[i].clamp( 0 )

    moves.append( mvFossilTimeSlideUniform(fbd_tree, origin_time, fossils[i], weight = 1.0) )
}

ucln_mean ~ dnLoguniform(1e-5, 1e-1)
ucln_sigma ~ dnExponential(1 / 1.17481)
ucln_mu := ln(ucln_mean) - (0.5 * ucln_sigma^2)

moves.append( mvScale(ucln_mean, weight=10, tune=true) )
moves.append( mvScaleBactrian(ucln_mean, weight=10, tune=true) )
moves.append( mvScale(ucln_sigma, weight=10, tune=true) )
moves.append( mvScaleBactrian(ucln_sigma, weight=10, tune=true) )

for (i in 1:n_branches) {
    branch_rates[i] ~ dnLognormal(ucln_mu, ucln_sigma)
    moves.append( mvScale(branch_rates[i], weight=1, tune=true) )
}

moves.append( mvVectorScale(branch_rates, weight=2, tune=true) )
moves.append( mvVectorSingleElementScale(branch_rates, weight=1, tune=true) )

n_max_states = 4

inv_ix = morpho.getInvariantSiteIndices(excludeAmbiguous=TRUE)
morpho.excludeCharacter( inv_ix )
morpho.removeExcludedCharacters()

ordered_vect = [28, 29, 33, 100, 102, 123, 139, 148, 152, 160, 166, 177, 180, 192]

unord <- morpho
unord.excludeCharacter(ordered_vect)

order <- morpho
order.excludeCharacter(1:morpho.nchar())
order.includeCharacter(ordered_vect)

alpha ~ dnUniform(0, 1E6)
moves.append( mvScale(alpha, weight=9.0) )
char_rates := fnDiscretizeGamma(alpha, alpha, 4)

idx = 1

for (i in 2:n_max_states) {
    unordered[i - 1] <- unord
    unordered[i - 1].setNumStatesPartition(i)
    nc = unordered[i - 1].nchar()
    if (nc > 0) {
        Qu[idx] <- fnJC(i)
        unord_ctmc[idx] ~ dnPhyloCTMC(tree=fbd_tree, Q=Qu[idx], branchRates=branch_rates,
                                      siteRates=char_rates, type="Standard",
                                      coding="variable")
        unord_ctmc[idx].clamp(unordered[i - 1])
        idx = idx + 1
    }
}

ix = 1

for (i in 3:n_max_states) {
    ordered[i - 2] <- order
    ordered[i - 2].setNumStatesPartition(i)
    nco = ordered[i - 2].nchar()
    if (nco > 0) {
        Qo[ix] <- fnOrderedRateMatrix(i, lambda=1, mu=1)
        order_ctmc[ix] ~ dnPhyloCTMC(tree=fbd_tree, Q=Qo[ix], branchRates=branch_rates,
                                     siteRates=char_rates, type="Standard",
                                     coding="variable")
        order_ctmc[ix].clamp(ordered[i - 2])
        ix = ix + 1
    }
}

print("INIT_FINGERPRINT origin_time=")
print(origin_time)
print("INIT_FINGERPRINT ucln_mean=")
print(ucln_mean)
print("INIT_FINGERPRINT ucln_sigma=")
print(ucln_sigma)
print("INIT_FINGERPRINT diversification=")
print(diversification)
print("INIT_FINGERPRINT alpha=")
print(alpha)

mymodel = model(fbd_tree)
mymcmc = mcmc(mymodel, monitors, moves)
mymcmc.burnin(generations=2, tuningInterval=1000)

print("LOGMCMC_DUMP_FINISHED")
q()
