################################################################################
#
# Isolate remaining CTMC hypotheses at the shared starting state (seed 12345):
#   1. fnDiscretizeGamma site rates (ChiSquare quantile / incompleteGamma)
#   2. Mkv coding="variable" vs coding="all"
#   3. pruning (P v): per-partition lnL with JC vs ordered, with/without gamma
#
# No MCMC. Compare Mac vs Linux at outputPrecision=17.
#
################################################################################

seed(12345)
setOption("outputPrecision", "17", false)

taxa <- readTaxonData("data/ceratosauria_tip_ages.tsv")
morpho <- readDiscreteCharacterData("data/ceratosauria_morphology.nex")

n_taxa <- morpho.ntaxa()
n_branches <- 2 * n_taxa - 2

diversification ~ dnExponential(10.0)
rel_extinction ~ dnBeta(2.0, 1.0)
fossil_prob ~ dnUniform(0.0, 1.0)
speciation := diversification / abs(1.0 - rel_extinction)
extinction := (rel_extinction * diversification) / abs(1.0 - rel_extinction)
recovery := (fossil_prob / abs(1.0 - fossil_prob)) * extinction
rho <- 1

origin_time ~ dnExponential(lambda=1/(212.6 - 197.5), offset=197.5)

tree_dist = dnFBDP(rootAge=origin_time, lambda=speciation, mu=extinction, psi=recovery,
                   rho=rho, taxa=taxa)

backbone_tree = readTrees("data/abelisauroidea_backbone_incomplete_binary.tre", treetype="clock")[1]
init_tree = readTrees("data/abelisauroidea_initial.tre", treetype="clock")[1]
scaled_init_tree <- fnMinBLTimeScaling(init_tree, taxa, 5)

fbd_tree ~ dnConstrainedTopology(tree_dist, backbone=backbone_tree,
                                 initialTree=scaled_init_tree)

fossils = fbd_tree.getFossils()
for(i in 1:fossils.size())
{
    t[i] := tmrca(fbd_tree, clade(fossils[i]))
    a[i] <- fossils[i].getMinAge()
    b[i] <- fossils[i].getMaxAge()
    F[i] ~ dnUniform(t[i] - b[i], t[i] - a[i])
    F[i].clamp( 0 )
}

ucln_mean ~ dnLoguniform(1e-5, 1e-1)
ucln_sigma ~ dnExponential(1 / 1.17481)
ucln_mu := ln(ucln_mean) - (0.5 * ucln_sigma^2)

for (i in 1:n_branches) {
    branch_rates[i] ~ dnLognormal(ucln_mu, ucln_sigma)
}

n_max_states = 4

inv_ix = morpho.getInvariantSiteIndices(excludeAmbiguous=TRUE)
morpho.excludeCharacter( inv_ix )
morpho.removeExcludedCharacters()

ordered_vect = [28, 29, 33, 100, 102, 123, 139, 148, 152, 160, 166, 177, 180, 192]

unord <- morpho
unord.excludeCharacter(ordered_vect)

order <- morpho
order.excludeCharacter(1:morpho.nchar())
order.includeCharacter(ordered_vect)

alpha ~ dnUniform(0, 1E6)
char_rates := fnDiscretizeGamma(alpha, alpha, 4)

print("INIT_FINGERPRINT origin_time=")
print(origin_time)
print("INIT_FINGERPRINT ucln_mean=")
print(ucln_mean)
print("INIT_FINGERPRINT ucln_sigma=")
print(ucln_sigma)
print("INIT_FINGERPRINT diversification=")
print(diversification)
print("INIT_FINGERPRINT alpha=")
print(alpha)

for (i in 1:4)
{
    print("GAMMA_MODEL cat=" + i)
    print(char_rates[i])
}

alphas = [0.5, 1.0, 10.0, 763071.1]
for (k in 1:alphas.size())
{
    aa = alphas[k]
    rr <- fnDiscretizeGamma(aa, aa, 4)
    for (i in 1:4)
    {
        print("GAMMA_GRID alpha=" + aa + " cat=" + i)
        print(rr[i])
    }
}

idx = 1
for (i in 2:n_max_states) {
    unordered[i - 1] <- unord
    unordered[i - 1].setNumStatesPartition(i)
    nc = unordered[i - 1].nchar()
    if (nc > 0) {
        Qu[idx] <- fnJC(i)
        unord_var_sr[idx] ~ dnPhyloCTMC(tree=fbd_tree, Q=Qu[idx], branchRates=branch_rates,
                                        siteRates=char_rates, type="Standard", coding="variable")
        unord_var_sr[idx].clamp(unordered[i - 1])
        unord_all_sr[idx] ~ dnPhyloCTMC(tree=fbd_tree, Q=Qu[idx], branchRates=branch_rates,
                                        siteRates=char_rates, type="Standard", coding="all")
        unord_all_sr[idx].clamp(unordered[i - 1])
        unord_var_flat[idx] ~ dnPhyloCTMC(tree=fbd_tree, Q=Qu[idx], branchRates=branch_rates,
                                          type="Standard", coding="variable")
        unord_var_flat[idx].clamp(unordered[i - 1])
        unord_all_flat[idx] ~ dnPhyloCTMC(tree=fbd_tree, Q=Qu[idx], branchRates=branch_rates,
                                          type="Standard", coding="all")
        unord_all_flat[idx].clamp(unordered[i - 1])
        print("LNL partition=unord n=" + i + " nchar=" + nc + " coding=variable siteRates=yes")
        print(unord_var_sr[idx].lnProbability())
        print("LNL partition=unord n=" + i + " nchar=" + nc + " coding=all siteRates=yes")
        print(unord_all_sr[idx].lnProbability())
        print("LNL partition=unord n=" + i + " nchar=" + nc + " coding=variable siteRates=no")
        print(unord_var_flat[idx].lnProbability())
        print("LNL partition=unord n=" + i + " nchar=" + nc + " coding=all siteRates=no")
        print(unord_all_flat[idx].lnProbability())
        idx = idx + 1
    }
}

ix = 1
for (i in 3:n_max_states) {
    ordered[i - 2] <- order
    ordered[i - 2].setNumStatesPartition(i)
    nco = ordered[i - 2].nchar()
    if (nco > 0) {
        Qo[ix] <- fnOrderedRateMatrix(i, lambda=1, mu=1)
        order_var_sr[ix] ~ dnPhyloCTMC(tree=fbd_tree, Q=Qo[ix], branchRates=branch_rates,
                                       siteRates=char_rates, type="Standard", coding="variable")
        order_var_sr[ix].clamp(ordered[i - 2])
        order_all_sr[ix] ~ dnPhyloCTMC(tree=fbd_tree, Q=Qo[ix], branchRates=branch_rates,
                                       siteRates=char_rates, type="Standard", coding="all")
        order_all_sr[ix].clamp(ordered[i - 2])
        order_var_flat[ix] ~ dnPhyloCTMC(tree=fbd_tree, Q=Qo[ix], branchRates=branch_rates,
                                         type="Standard", coding="variable")
        order_var_flat[ix].clamp(ordered[i - 2])
        order_all_flat[ix] ~ dnPhyloCTMC(tree=fbd_tree, Q=Qo[ix], branchRates=branch_rates,
                                         type="Standard", coding="all")
        order_all_flat[ix].clamp(ordered[i - 2])
        print("LNL partition=order n=" + i + " nchar=" + nco + " coding=variable siteRates=yes")
        print(order_var_sr[ix].lnProbability())
        print("LNL partition=order n=" + i + " nchar=" + nco + " coding=all siteRates=yes")
        print(order_all_sr[ix].lnProbability())
        print("LNL partition=order n=" + i + " nchar=" + nco + " coding=variable siteRates=no")
        print(order_var_flat[ix].lnProbability())
        print("LNL partition=order n=" + i + " nchar=" + nco + " coding=all siteRates=no")
        print(order_all_flat[ix].lnProbability())
        ix = ix + 1
    }
}

print("HYPC_INIT_LNL_FINISHED")
q()
