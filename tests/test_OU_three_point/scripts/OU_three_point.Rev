################################################################################
#
# RevBayes Validation Test: three-point Ornstein-Uhlenbeck likelihood
#
################################################################################

seed(12345)

data <- readContinuousCharacterData("data/OU_three_point.nex")
psi <- readTrees("data/OU_three_point.tree")[1]

mvi = 0

alpha ~ dnExp(1.0)
moves[++mvi] = mvScale(alpha, lambda=1.0, tune=true, weight=2.0)

sigma ~ dnExp(1.0)
moves[++mvi] = mvScale(sigma, lambda=1.0, tune=true, weight=2.0)

theta ~ dnNormal(0.0, 1.0)
moves[++mvi] = mvSlide(theta, delta=0.5, tune=true, weight=2.0)

root_state ~ dnNormal(0.0, 1.0)
moves[++mvi] = mvSlide(root_state, delta=0.5, tune=true, weight=2.0)

traits ~ dnPhyloOrnsteinUhlenbeckThreePoint(tree=psi, alpha=alpha, sigma=sigma, theta=theta, rootStates=root_state, nSites=1)
traits.clamp(data)

mymodel = model(psi)

mni = 0
monitors[++mni] = mnModel(filename="output/OU_three_point.log", printgen=10, separator=TAB)

mymcmc = mcmc(mymodel, monitors, moves)
mymcmc.run(generations=50)

q()
