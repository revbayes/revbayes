# Checks that an assembled time tree carries the true likelihood through topology changes,
# node age slides and subtree scales. The cached likelihood after the chain is compared with
# one computed afresh from a checkpoint.
# Every line printed must be TRUE.
out = "output/treeAssembly_mcmc_timetree.txt"
print(filename=out, "an assembled time tree carries the true likelihood under every move:\n")

chars <- readDiscreteCharacterData("data/primates_cytb_small.nex")
taxa <- chars.taxa()
root_age <- 10.0

agree = TRUE
for (rep in 1:3) {
    for (pass in 1:2) {
        seed(rep)
        tree ~ dnBDP(lambda=0.4, mu=0.1, rho=1.0, rootAge=root_age, taxa=taxa, condition="nTaxa")

        # the lengths are the assembly's own, so the input's ages are no concern of its readers
        for (i in 1:(2 * taxa.size() - 2)) { bl[i] ~ dnExponential(10) }
        assembled := fnTreeAssembly(tree, bl)
        seq ~ dnPhyloCTMC(tree=assembled, Q=fnJC(4), branchRates=0.05, type="DNA")
        seq.clamp(chars)
        idle ~ dnUniform(0, 1)

        w = ifelse(pass == 1, 1.0, 1E-9)
        moves = [ mvFNPR(tree, weight=5*w), mvNarrow(tree, weight=5*w),
                  mvNodeTimeSlideUniform(tree, weight=5*w), mvSubtreeScale(tree, weight=5*w),
                  mvSlide(idle, weight=20/w) ]
        for (i in 1:(2 * taxa.size() - 2)) { moves.append( mvScale(bl[i], weight=w) ) }

        log = "output/treeAssembly_mcmc_timetree_" + rep + "_" + pass + ".log"
        state = "output/treeAssembly_mcmc_timetree_" + rep + ".state"
        m = mcmc(model(tree, idle), [ mnFile(filename=log, printgen=10, idle) ], moves, moveschedule="single")
        if (pass == 1) {
            m.run(generations=3000, checkpointFile=state, checkpointInterval=3000)
            cached = readTrace(log, burnin=0)[3].getValues()
        } else {
            m.initializeFromCheckpoint(state)
            m.run(generations=1000)
            fresh = readTrace(log, burnin=0)[3].getValues()
        }
    }
    agree = agree && abs(cached[cached.size()] - fresh[fresh.size()]) < 1E-6
}
print(filename=out, append=TRUE, agree, "\n")

q()
