/* Graphical model description in DOT language                                    */
/*    To view graph:                                                              */
/*       open this file in the program Graphviz: http://www.graphviz.org          */
/*       or paste contents into an online viewer: http://stamm-wilbrandt.de/GraphvizFiddle */

digraph REVDAG {
   n_phylogeny [shape=oval, style="dashed,filled", fillcolor=white, label="phylogeny\n[ fnTreeAssembly(Tree<any>) ]"]
   n_topology [shape=oval, style=filled, fillcolor=white, label="topology"]
   n_br_lengths [shape=oval, style="dashed,filled", fillcolor=white, label="br_lengths\n[ mul(Simplex<any>) ]"]
   n_rel_br_lengths [shape=oval, style=filled, fillcolor=white, label="rel_br_lengths"]
   n_unnamed_0 [shape=box, style=filled, fillcolor=white, label="[ 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000, 1.000 ]"]
   n_tree_length [shape=oval, style=filled, fillcolor=white, label="tree_length"]
   n_unnamed_1 [shape=box, style=filled, fillcolor=white, label="2"]
   n_unnamed_2 [shape=box, style=filled, fillcolor=white, label="1"]
   n_m_morph_1 [shape=oval, style=filled, fillcolor=gray, label="m_morph[1]"]
   n_m_morph_1_branchRates [shape=record, style=filled, fillcolor=white, label="{m_morph[1].branchRates|1}"]
   n_unnamed_3 [shape=box, style=filled, fillcolor=white, label="..."]
   n_lnL [shape=oval, style="dashed,filled", fillcolor=white, label="lnL\n[ lnProbability()) ]"]
   n_m_morph [shape=oval, style="dashed,filled", fillcolor=white, label="m_morph\n[ v(AbstractHomologousDiscreteCharacterData<any>) ]"]
   n_phylogeny -> n_m_morph_1
   n_topology -> n_phylogeny[style=dashed]
   n_br_lengths -> n_phylogeny[style=dashed]
   n_rel_br_lengths -> n_br_lengths[style=dashed]
   n_unnamed_0 -> n_rel_br_lengths
   n_tree_length -> n_br_lengths[style=dashed]
   n_unnamed_1 -> n_tree_length
   n_unnamed_2 -> n_tree_length
   n_m_morph_1 -> n_lnL[style=dashed]
   n_m_morph_1 -> n_m_morph[style=dashed]
   n_m_morph_1_branchRates -> n_m_morph_1
   n_unnamed_3 -> n_m_morph_1
   {rank=same; n_m_morph_1;}
   graph [bgcolor=lavenderblush2, pad=0.25]
}